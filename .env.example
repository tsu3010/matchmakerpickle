# Copy to .env for local dev. On Vercel, set these under Project → Settings → Environment Variables.

# Which vision provider reads the Reclub screenshots: gemini | openai
VISION_PROVIDER=gemini

# --- Gemini (default) ---
GEMINI_API_KEY=your-gemini-api-key
# Optional: any Gemini model that accepts images
GEMINI_MODEL=gemini-3.8-flash

# --- Any OpenAI-compatible API (OpenAI, Groq, OpenRouter, Cloudflare...) ---
# VISION_PROVIDER=openai
# OPENAI_API_KEY=...
# OPENAI_MODEL=...            # a model that accepts image input
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: require this passcode before screenshots can be read
# (stops strangers who find your URL from using your API quota)
# APP_PASSCODE=1234
